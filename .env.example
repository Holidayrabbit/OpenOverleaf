# OpenAI-compatible chat API. Leave blank to run without the agent.
OPENAI_API_KEY=

# Optional. Default: https://api.openai.com/v1
# Ollama example: http://127.0.0.1:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. The model must support tool calling.
OPENAI_MODEL=gpt-4o-mini

# Project directory the studio edits. Relative to the repo root, or absolute.
# Use forward slashes on Windows too: WORKSPACE_DIR=C:/Users/me/paper
WORKSPACE_DIR=workspace/demo

# Optional shell for the integrated terminal and run_terminal.
# Default: PowerShell on Windows, $SHELL or bash/sh on macOS and Linux.
# Git Bash example: OPENOVERLEAF_SHELL=C:/Program Files/Git/bin/bash.exe
# OPENOVERLEAF_SHELL=
# TEXAGENT_SHELL is still read if OPENOVERLEAF_SHELL is unset.

# API port. In production this process also serves the built web app.
PORT=43124

# Bind address. Loopback by default; there is no authentication.
# HOST=127.0.0.1
